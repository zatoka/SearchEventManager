# SearchEventsManager - Ticketmaster API key SEED file (example).
#
# Copy this file to "ticketmaster.env" in the same folder and paste your key.
# Get a free key at https://developer.ticketmaster.com/
#
# On first start the app copies ticketmaster.env to:
#     %APPDATA%\search-events-manager\.env
# and from then on reads the key only from that AppData file.
TICKETMASTER_API_KEY=your_api_key_here
TICKETMASTER_API_SECRET=
