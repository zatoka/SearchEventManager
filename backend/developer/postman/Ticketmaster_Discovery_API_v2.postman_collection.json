    {
      "name": "Classifications",
      "item": [
        {
          "name": "Classification Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/classifications.json?size=10&apikey={{apikey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "classifications.json"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "10",
                  "disabled": false
                },
                {
                  "key": "apikey",
                  "value": "{{apikey}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "const list = (body._embedded && body._embedded.classifications) || [];",
                  "if (list.length && list[0].id) pm.environment.set('classificationId', list[0].id);",
                  "const first = list[0] || {};",
                  "if (first.segment && first.segment.id) pm.environment.set('segmentId', first.segment.id);",
                  "if (first.genre && first.genre.id) pm.environment.set('genreId', first.genre.id);",
                  "if (first.subGenre && first.subGenre.id) pm.environment.set('subGenreId', first.subGenre.id);",
                  "const segment = first.segment || {};",
                  "if (segment.id) pm.environment.set('segmentId', segment.id);",
                  "const genres = (segment._embedded && segment._embedded.genres) || [];",
                  "if (genres.length && genres[0].id) {",
                  "  pm.environment.set('genreId', genres[0].id);",
                  "  const subs = (genres[0]._embedded && genres[0]._embedded.subgenres) || [];",
                  "  if (subs.length && subs[0].id) pm.environment.set('subGenreId', subs[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
