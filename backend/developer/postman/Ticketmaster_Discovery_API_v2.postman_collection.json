    {
      "name": "Events",
      "item": [
        {
          "name": "Event Search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events.json?city={{city}}&stateCode={{stateCode}}&countryCode={{countryCode}}&size=5&apikey={{apikey}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events.json"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "{{city}}",
                  "disabled": false
                },
                {
                  "key": "stateCode",
                  "value": "{{stateCode}}",
                  "disabled": false
                },
                {
                  "key": "countryCode",
                  "value": "{{countryCode}}",
                  "disabled": false
                },
                {
                  "key": "size",
                  "value": "5",
                  "disabled": false
                },
                {
                  "key": "apikey",
                  "value": "{{apikey}}"
                }
              ]
            },
            "description": "Search events and save first event ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "const body = pm.response.json();",
                  "const list = (body._embedded && body._embedded.events) || [];",
                  "if (list.length && list[0].id) pm.environment.set('eventId', list[0].id);"
                ]
              }
            }
          ]
        },
